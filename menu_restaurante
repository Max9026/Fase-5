# Menú del restaurante
productos = [
    ["Hamburguesa", "Comida Rapida", 25000],
    ["Qbano", "Comida Rapida", 30000],
    ["Ensalada", "Saludable", 18000],
    ["Limonada de coco", "Bebidas", 12000],
    ["Pasta Napolitana", "Pasta", 35000],
    ["Lasagna", "Pasta", 40000]
]

# Función para calcular el precio final
def calcular_total(nombre_categoria, precio_base):

    descuento = 0

    # Verificar si aplica promoción
    if nombre_categoria == "Pasta":
        if precio_base > 30000:
            descuento = precio_base * 0.15

    # Calcular precio final
    precio_final = precio_base - descuento

    return int(precio_final)


print("------ MENU DEL RESTAURANTE ------")

# Recorrer productos del menú
for dato in productos:

    producto = dato[0]
    categoria = dato[1]
    valor = dato[2]

    total = calcular_total(categoria, valor)

    print("-----------------------------")
    print("Producto:", producto)
    print("Categoria:", categoria)
    print("Precio base: $", valor)
    print("Precio final: $", total)